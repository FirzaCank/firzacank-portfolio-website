# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Gemini API key for the RAG chat assistant and embedding builds.
# Get a free key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Resend API key for the contact form email endpoint.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Public site URL used for SEO metadata and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Upstash Redis for chat rate-limit counters that survive cold
# starts (production). Leave unset locally; the code falls back to in-memory.
# Get both from https://console.upstash.com after creating a Redis database.
# UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXxxxxxxxxxxxxxxxxxxxxxxxx

# Optional, local UI testing only. `next dev` cannot serve api/chat.py (it is a
# Vercel Python function), so run `python3 scripts/serve_chat.py` and point the
# widget at it. Remove both before building: NEXT_PUBLIC_* is inlined into the
# browser bundle, so a stale value ships localhost into the build output.
# NEXT_PUBLIC_CHAT_API_URL=http://localhost:8000/api/chat
# CONTACT_API_URL=http://localhost:3000/api/contact
