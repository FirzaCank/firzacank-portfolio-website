# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Gemini API key for the RAG chat assistant and embedding builds.
# Get a free key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Resend API key for the contact form email endpoint.
# Get one at https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Public site URL used for SEO metadata and canonical links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
